# Токен бота от @BotFather
BOT_TOKEN=

# Telegram ID администраторов через запятую, например: 111,222
# Админ правит и удаляет любые темы, включая встроенные, и его правки живут в базе:
# сид перестаёт синхронизировать изменённую тему с JSON.
# Пусто — встроенные темы не правит никто.
ADMIN_IDS=

# Путь к файлу базы данных
DB_PATH=data/bond_bot.sqlite3
